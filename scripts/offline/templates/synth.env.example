# Synth — пример переменных окружения для offline-дистрибутива.
#
# Linux (systemd): EnvironmentFile=/etc/synth/synth.env
#   Порт/хост/данные задаются аргументами ExecStart и имеют приоритет.
# macOS (LaunchAgent): переменные задаются в plist (EnvironmentVariables).
# Windows: переменные задаются в start-synth.ps1 / системном окружении.
#
# Приоритет: CLI-флаги > SYNTH_* env > config.yaml > defaults (ADR-023).

# Каталог данных (переопределяет storage.dataDir)
# SYNTH_DATA_DIR=/var/lib/synth/data

# Путь к config.yaml
# SYNTH_CONFIG=/etc/synth/config.yaml

# Порт и адрес локального core (для `synth serve`)
# SYNTH_PORT=4300
# SYNTH_HOST=127.0.0.1

# Наблюдаемость (ADR-094)
# SYNTH_METRICS_ENABLED=false
# SYNTH_METRICS_TOKEN=            # только env; значение не коммитить

# Прокси/TLS (ADR-099) — секреты только через env или файлы {dataDir}/secrets/
# SYNTH_PROXY_PASSWORD=
# SYNTH_TLS_CA_FILE=
