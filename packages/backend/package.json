{
  "name": "@synth/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc && mkdir -p dist/agents && cp -r src/agents/definitions dist/agents/definitions",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@hono/node-server": "^1.18.0",
    "@synth/core": "workspace:*",
    "@synth/shared": "workspace:*",
    "hono": "^4.9.0",
    "ws": "^8.20.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.0.0",
    "typescript": "^5.8.0"
  }
}
