{
  "name": "@itphx/synth-backend",
  "version": "0.10.2",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@hono/node-server": "^1.18.0",
    "@itphx/synth-core": "workspace:*",
    "@itphx/synth-shared": "workspace:*",
    "hono": "^4.9.0",
    "hono-rate-limiter": "^0.5.3",
    "jose": "^6.2.3",
    "js-yaml": "^4.1.1",
    "ws": "^8.20.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.0.0",
    "typescript": "^5.8.0"
  }
}
