{
  "name": "@itphx/synth-plugin-memory",
  "version": "0.1.0",
  "description": "Плагин памяти Synth: факты с provenance, recall по вопросу хода, поиск/запись/отзыв фактов (ADR-107, docs/MEMORY.md)",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "synth.pack"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=esm --platform=node --target=node20 --external:@itphx/* --outfile=dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@itphx/synth-core": "workspace:*",
    "@itphx/synth-shared": "workspace:*"
  },
  "devDependencies": {
    "@itphx/synth-core": "workspace:*",
    "@itphx/synth-shared": "workspace:*",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.8.0",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
