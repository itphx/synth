{
  "name": "@itphx/synth-core",
  "version": "0.8.2",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "prompts",
    "dictionaries",
    "definitions"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./remote": {
      "types": "./dist/remote/index.d.ts",
      "import": "./dist/remote/index.js"
    },
    "./server/app.js": {
      "types": "./dist/server/app.d.ts",
      "import": "./dist/server/app.js"
    },
    "./server/chat.js": {
      "types": "./dist/server/chat.d.ts",
      "import": "./dist/server/chat.js"
    },
    "./server/serialize.js": {
      "types": "./dist/server/serialize.d.ts",
      "import": "./dist/server/serialize.js"
    },
    "./storage/json-store.js": {
      "types": "./dist/storage/json-store.d.ts",
      "import": "./dist/storage/json-store.js"
    },
    "./storage/project-store.js": {
      "types": "./dist/storage/project-store.d.ts",
      "import": "./dist/storage/project-store.js"
    },
    "./auth/local.js": {
      "types": "./dist/auth/local.d.ts",
      "import": "./dist/auth/local.js"
    },
    "./engine/gateway/index.js": {
      "types": "./dist/engine/gateway/index.d.ts",
      "import": "./dist/engine/gateway/index.js"
    }
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp -r prompts/. dist/prompts/ && cp -r dictionaries/. dist/dictionaries/ && cp -r definitions/. dist/definitions/ && mkdir -p dist/engine/agents/definitions && cp src/engine/agents/definitions/*.json dist/engine/agents/definitions/",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@hono/node-server": "^1.18.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@itphx/synth-shared": "workspace:*",
    "commander": "^14.0.3",
    "hono": "^4.9.0",
    "parse5": "^8.0.1",
    "simple-git": "^3.36.0",
    "ws": "^8.20.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.0.0",
    "typescript": "^5.8.0"
  }
}
