{
  "name": "@itphx/synth-executor",
  "version": "0.12.0",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@itphx/synth-shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "hono": "^4.9.0",
    "zod": "^3.24.0"
  },
  "peerDependencies": {
    "@itphx/synth-core": "workspace:*"
  },
  "devDependencies": {
    "@itphx/synth-core": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
