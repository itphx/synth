      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (route) (rate(synth_http_requests_total{env=~\"$env\", instance=~\"$instance\", route!=\"other\"}[$__rate_interval]))",
          "legendFormat": "{{route}}",
          "editorMode": "code",
          "range": true,
          "instant": false
