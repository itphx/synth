    {
      "id": 6,
      "type": "timeseries",
      "title": "RPS по route",
      "description": "sum by (route) rate(synth_http_requests_total) — unknown/other сведены в other",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
