# Образ synth-executor — исполнитель агентских команд (ADR-077 шаг 7a,
# PROP-082 шаг 5). Worker в split-топологии: control plane (backend) в одном
# контейнере, исполнитель — в отдельном; связь — HTTP по протоколу
# `ExecutionPort` с bearer-токеном.
#
# В образе НЕТ control plane: ни OIDC/RBAC, ни LLM-конфигурации, ни ключей
# (инвариант 13). Токен доступа к API исполнителя и корень workspace
# передаются в рантайме через env и ОБЯЗАТЕЛЬНЫ (fail-closed, см.
# packages/executor/src/config.ts).
#
# Стадии:
#   build   — сборка монорепо (платформа билдера, `$BUILDPLATFORM`);
#   core    — flavor `core`: hard deps + tier 0 + рантайм исполнителя;
#   dev     — flavor `dev`: core + tier 1 + tier 4 + tier 5 + БД-клиенты +
#             buildah + ffmpeg + pnpm;
#   devops  — flavor `devops`: dev + tier 2 + диаг + docker CLI;
#   browser — flavor `browser` (debian-ветка): hard deps + tier 0 + tier 1 +
#             tier 3 (Playwright + Chromium) + диаг + ffmpeg (без pnpm);
#   full    — flavor `full` (debian-ветка): browser + tier 2 + tier 4 + tier 5 +
#             БД + docker CLI + buildah + pnpm.
#
# pnpm в образе (flavor'ы `dev`/`devops`/`full`): версия зафиксирована
# (pnpm@12.14.0 — как `packageManager` в package.json репозитория) и
# разворачивается через corepack в HOME пользователя uid 1000. Это позволяет
# внутри контейнера выполнить `pnpm install --frozen-lockfile && pnpm build &&
# pnpm typecheck && pnpm lint`, а также `helm lint`/`helm template` чарта
# (tier 5 — проверка чарта/скриптов/Dockerfile'ов репозитория Synth).
#
# Store пакетов НЕ запечён: `pnpm install` в контейнере идёт в сеть (нужен
# egress к npm-реестру) и кладёт пакеты в дефолтный store в HOME. Собственный
# store в образе не даёт офлайна (кэш метаданных реестра всё равно нужен), а
# весит сотни мегабайт.
#
# ffmpeg (ADR-115) — в flavor'ах `dev`/`browser`/`full`: без него обработка
# вложений деградирует (`no_ffmpeg`, ADR-078).
#
# Flavor'ы `core`/`dev`/`devops` — alpine-ветка; `browser`/`full` — debian
# (`node:22-bookworm-slim`): Playwright/Chromium не имеют сборок под musl.
# Списки пакетов НЕ дублируются: используются те же `docker/install-*.sh`,
# что и у all-in-one (docker/Dockerfile.backend).
#
# multi-arch: стадия сборки идёт на платформе билдера (`$BUILDPLATFORM`),
# flavor-стадии — на целевой (в них есть `RUN` с установкой пакетов), поэтому
# arm64-сборка flavor'а требует QEMU/binfmt (PROP-082, решение по arm64 —
# вариант A). `${BUILDPLATFORM:-linux/amd64}` — дефолт для kaniko/legacy
# `docker build`.
#
# PID 1 и зомби (аудит 0.13.4 §5.2). Runtime-стадии запускают не `dist/main.js`,
# а `docker/init.sh` (`synth-init`) → `dist/init.js`
# (`packages/executor/src/init.ts`) → `dist/main.js`:
#   * reaping осиротевших детей делает только PID 1, и это умеет POSIX-шелл
#     (`waitpid(-1)` в обработчике SIGCHLD), но НЕ Node: libuv ждёт лишь pid'ы
#     своих handle'ов, поэтому усыновлённые сироты остаются зомби (проверено на
#     node 22.23 / libuv 1.51). Для исполнителя это критично: он массово
#     порождает процессы (shell-команды тулов, фоновые прогоны, MCP-серверы);
#   * Node-обёртка запускает приложение отдельной process group, пробрасывает
#     SIGTERM/SIGINT/SIGHUP всей группе (штатное гашение фоновых процессов —
#     `main.ts`) и сохраняет код выхода (гибель от сигнала — 128+N);
#   * `tini`/`docker-init` в образ не ставится: это лишний пакет в runtime, а
#     `sh` уже есть в базовом образе.

ARG BUILDPLATFORM

FROM --platform=${BUILDPLATFORM:-linux/amd64} node:22-alpine AS build

# corepack скачивает бинарь pnpm при ПЕРВОМ вызове `pnpm` — то есть уже в
# следующем слое, где сеть может отвалиться (сборка падает на таймауте
# загрузки). Поэтому materialize бинаря здесь, в кэшируемом слое: сбой сети
# тогда не роняет сборку целиком, а повторная попытка переиспользует слой.
#
# Версия pnpm зафиксирована и совпадает с `packageManager` в package.json
# репозитория (pnpm@12.14.0) — иначе `pnpm install --frozen-lockfile` в
# flavor-стадиях и в контейнере работал бы на ДРУГОЙ версии pnpm, чем CI.
RUN corepack enable && corepack prepare pnpm@12.14.0 --activate && pnpm --version

WORKDIR /repo

# Копируем весь монорепо целиком (для workspace-зависимостей и сборки
# shared → core → executor).
COPY . .

# Порядок сборки — по зависимостям: shared → core → executor.
#
# `@itphx/synth-executor` объявляет `@itphx/synth-core` как peerDependency и
# импортирует его В РАНТАЙМЕ (`InlineExecutionPort`, `ExecutionError`,
# `egressFetch`), поэтому в образ обязателен `dist` core — «лёгкий worker без
# node-приложения» из PROP-082 в этом смысле не реализуем (см. уточнение в
# PROP-082, шаг 5).
RUN pnpm install --filter @itphx/synth-executor --filter @itphx/synth-core --filter @itphx/synth-shared \
    && pnpm --filter @itphx/synth-shared build \
    && pnpm --filter @itphx/synth-core build \
    && pnpm --filter @itphx/synth-executor build

# pnpm deploy создаёт самодостаточную папку с реальными node_modules (без
# symlinks в пакеты workspace). Два отдельных deploy'а:
#   * /out/app  — пакет исполнителя (его `dist` + `hono` + `@itphx/synth-shared`);
#   * /out/core — пакет core (`dist` + его runtime-зависимости), который
#     исполнитель импортирует в рантайме.
# `--no-optional`: core тянет `@itphx/synth-executor` и
# `@itphx/synth-storage-postgres` как optionalDependencies — в образе
# исполнителя они не нужны (storage-postgres — драйвер БД control plane).
RUN mkdir -p /out \
    && pnpm --filter @itphx/synth-executor deploy --prod --legacy --no-optional /out/app \
    && pnpm --filter @itphx/synth-core deploy --prod --legacy --no-optional /out/core

# Права чиним на платформе билдера: файлы pnpm deploy имеют mode 770 (root)
# и под runAsUser 1000 недоступны. В целевой стадии права не чинятся (важно
# для кросс-сборки arm64 без эмуляции) — COPY сохраняет режимы как есть.
# `synth-init` копируется в runtime-стадии из build (`COPY` переносит режим как
# есть) — при umask/ACL контекста он может стать 0711, и uid 1000 не прочитает
# его (`sh: can't open …: Permission denied`). Поэтому чиним и его.
RUN chmod -R a+rX /out/app /out/core /repo/docker/init.sh

# ------------------------------------------------------------------------------
# flavor `core` — рантайм исполнителя + hard deps + tier 0
# ------------------------------------------------------------------------------
FROM node:22-alpine AS core

LABEL org.opencontainers.image.source="https://github.com/itphx/synth"
LABEL org.opencontainers.image.licenses="MIT"
LABEL org.opencontainers.image.title="Synth Executor (core)"
LABEL org.opencontainers.image.description="Synth executor: runtime исполнителя + toolchain (hard deps + tier 0)."

ENV NODE_ENV=production
# Адрес/порт исполнителя — дефолты пакета (packages/executor/src/config.ts).
# Токен и корень workspace НЕ задаются: они обязательны и передаются
# в рантайме (fail-closed).
ENV SYNTH_EXECUTOR_HOST=0.0.0.0
ENV SYNTH_EXECUTOR_PORT=5100

# Toolchain: hard deps (git, ripgrep, python3 + pip + venv, openssh-client,
# rsync, ca-certificates) + tier 0 (bash, curl, jq, yq, unzip/zip, xz, zstd, GNU
# coreutils/findutils/grep/sed/gawk, less, tree, openssl).
COPY docker/install-lib.sh docker/install-hard-deps.sh docker/install-tier-0.sh /tmp/synth-install/
RUN set -eux; \
    sh /tmp/synth-install/install-hard-deps.sh; \
    sh /tmp/synth-install/install-tier-0.sh; \
    rm -rf /tmp/synth-install

# Каталоги пользователя uid 1000 и его HOME (как в all-in-one: чарт запускает
# процессы с runAsUser: 1000, а HOME по умолчанию /root — не writable).
# В `node:22-alpine` uid/gid 1000 уже заняты пользователем `node`, поэтому
# отдельная учётная запись не создаётся — важен сам uid.
RUN set -eux; \
    mkdir -p /home/synth/.cache/pip /home/synth/.local /workspace; \
    chown -R 1000:1000 /home/synth /workspace

ENV HOME=/home/synth
ENV PYTHONUSERBASE=/home/synth/.local
ENV PIP_CACHE_DIR=/home/synth/.cache/pip

# Рантайм исполнителя: пакет исполнителя + core (импортируется в рантайме).
COPY --from=build /out/app /app
COPY --from=build /out/core /opt/synth-core

WORKDIR /app

# `@itphx/synth-core` — peerDependency исполнителя: pnpm не выносит peer в
# верхний уровень node_modules, поэтому пакет доступен по явному симлинку.
# Node разыменовывает симлинку и резолвит зависимости core от её реального
# пути (/opt/synth-core/node_modules) — то есть рантайм самодостаточен.
# Проверка в образе — fail-closed: без рабочего `InlineExecutionPort`
# исполнитель не сможет исполнять команды, и это должно быть видно на
# этапе сборки, а не в рантайме.
RUN set -eux; \
    mkdir -p /app/node_modules/@itphx; \
    ln -sfn /opt/synth-core /app/node_modules/@itphx/synth-core; \
    node -e "import('@itphx/synth-core').then((m) => { if (!m.InlineExecutionPort) { throw new Error('core без InlineExecutionPort'); } console.log('core runtime OK'); }).catch((e) => { console.error(e); process.exit(1); })"

EXPOSE 5100
# PID 1 (аудит 0.13.4 §5.2): `synth-init` — sh-скрипт (reaping осиротевших
# детей; Node/libuv этого не умеет), он запускает `dist/init.js` — Node-обёртку
# (проброс сигналов всей process group и кода выхода). Шапка файла.
COPY --from=build /repo/docker/init.sh /usr/local/bin/synth-init
CMD ["/bin/sh", "/usr/local/bin/synth-init", "node", "dist/init.js"]

# ------------------------------------------------------------------------------
# flavor `dev` — core + tier 1 + tier 4 + tier 5 + БД-клиенты + buildah + ffmpeg
# ------------------------------------------------------------------------------
FROM core AS dev

LABEL org.opencontainers.image.source="https://github.com/itphx/synth"
LABEL org.opencontainers.image.licenses="MIT"
LABEL org.opencontainers.image.title="Synth Executor (dev)"
LABEL org.opencontainers.image.description="Synth executor: runtime исполнителя + toolchain (hard deps, tier 0-1, tier 4 MCP servers, tier 5 repo lint, DB clients, buildah, ffmpeg)."

# pnpm в образе: flavor `dev` умеет собирать монорепо внутри контейнера
# (`pnpm install --frozen-lockfile && pnpm build && pnpm typecheck &&
# pnpm lint`) и проверять чарт/скрипты/Dockerfile'ы репозитория (tier 5).
#
# Окружение corepack/pnpm — в HOME пользователя uid 1000 (процесс исполнителя
# идёт под runAsUser: 1000, HOME=/root недоступен для записи):
#   * COREPACK_HOME — кэш corepack (сюда материализуется бинарь pnpm);
#   * PNPM_HOME     — каталог глобальных бинарей pnpm (в PATH).
ENV COREPACK_HOME=/home/synth/.cache/node/corepack
ENV PNPM_HOME=/home/synth/.local/share/pnpm
ENV PATH=$PNPM_HOME:$PATH

# Версия pnpm зафиксирована и совпадает с `packageManager` в package.json
# репозитория (pnpm@12.14.0).
#
# `pnpm --version` здесь — не проверка, а MATERIALIZATION нативного бинаря:
# corepack кладёт в образ пакет-обёртку pnpm, а нативный бинарь
# (`@pnpm/exe.<platform>-<arch>`) обёртка скачивает при ПЕРВОМ запуске. Без
# этого шага первый вызов `pnpm` в контейнере требовал бы сети (и печатал
# «Downloading the pnpm … binary» перед версией).
RUN set -eux; \
    corepack enable && corepack prepare pnpm@12.14.0 --activate; \
    pnpm --version; \
    mkdir -p /home/synth/.cache/node/corepack /home/synth/.local/share/pnpm; \
    chown -R 1000:1000 /home/synth/.cache/node/corepack \
             /home/synth/.local/share/pnpm

# Git в контейнере работает с workspace'ами монтируемыми в образ (том
# `synth-workspace`), а рабочий каталог сессии указывает внутрь тома — git
# отказывается работать в чужом репозитории («dubious ownership»). Поэтому
# каталоги workspace'ов помечаются безопасными, а пользователь коммитов задаётся
# системно (иначе `git commit` в контейнере падал бы с «Please tell me who you
# are»).
RUN set -eux; \
    git config --system --add safe.directory '/var/synth/data/workspaces/*'; \
    git config --system user.name "Synth Agent"; \
    git config --system user.email "agent@synth.local"

COPY docker/install-lib.sh docker/install-tier-1.sh docker/install-tier-5.sh \
     docker/install-media.sh docker/install-db-clients.sh \
     docker/install-buildah.sh docker/install-tier-4.sh /tmp/synth-install/
RUN set -eux; \
    sh /tmp/synth-install/install-tier-1.sh; \
    sh /tmp/synth-install/install-tier-5.sh; \
    sh /tmp/synth-install/install-media.sh; \
    sh /tmp/synth-install/install-db-clients.sh; \
    sh /tmp/synth-install/install-buildah.sh
# npm-слой (tier 4) отдельным RUN: смена состава MCP-серверов не должна
# инвалидировать слои с системными пакетами.
RUN set -eux; \
    sh /tmp/synth-install/install-tier-4.sh; \
    rm -rf /tmp/synth-install

# ------------------------------------------------------------------------------
# flavor `devops` — dev + tier 2 + диаг + docker CLI
# ------------------------------------------------------------------------------
FROM dev AS devops

LABEL org.opencontainers.image.source="https://github.com/itphx/synth"
LABEL org.opencontainers.image.licenses="MIT"
LABEL org.opencontainers.image.title="Synth Executor (devops)"
LABEL org.opencontainers.image.description="Synth executor: runtime исполнителя + toolchain (hard deps, tier 0-2, tier 4 MCP servers, DB clients, buildah, diag tools, docker CLI)."

COPY docker/install-lib.sh docker/install-tier-2.sh docker/install-diag.sh \
     docker/install-docker-cli.sh /tmp/synth-install/
RUN set -eux; \
    sh /tmp/synth-install/install-tier-2.sh; \
    sh /tmp/synth-install/install-diag.sh; \
    sh /tmp/synth-install/install-docker-cli.sh; \
    rm -rf /tmp/synth-install

# ------------------------------------------------------------------------------
# debian-ветка: flavor'ы `browser`/`full` (PROP-082, шаг 5)
# ------------------------------------------------------------------------------
#
# База — `node:22-bookworm-slim` (glibc): Playwright/Chromium официально не
# поддерживают musl. Состав toolchain'а — тот же, что у all-in-one
# (docker/Dockerfile.backend), но без control plane.
FROM node:22-bookworm-slim AS browser

LABEL org.opencontainers.image.source="https://github.com/itphx/synth"
LABEL org.opencontainers.image.licenses="MIT"
LABEL org.opencontainers.image.title="Synth Executor (browser)"
LABEL org.opencontainers.image.description="Synth executor: runtime исполнителя + toolchain (hard deps, tier 0-1, tier 3 Playwright/Chromium, MCP playwright, diag)."

ENV NODE_ENV=production
ENV SYNTH_EXECUTOR_HOST=0.0.0.0
ENV SYNTH_EXECUTOR_PORT=5100

COPY docker/install-lib.sh docker/install-hard-deps.sh docker/install-tier-0.sh /tmp/synth-install/
RUN set -eux; \
    sh /tmp/synth-install/install-hard-deps.sh; \
    sh /tmp/synth-install/install-tier-0.sh; \
    rm -rf /tmp/synth-install

RUN set -eux; \
    mkdir -p /home/synth/.cache/pip /home/synth/.local /workspace; \
    chown -R 1000:1000 /home/synth /workspace

ENV HOME=/home/synth
ENV PYTHONUSERBASE=/home/synth/.local
ENV PIP_CACHE_DIR=/home/synth/.cache/pip

# Каталог браузеров Playwright: общий для всех пользователей образа.
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright

# tier 1 (сборка) + tier 3 (playwright + Chromium) + диагностика + ffmpeg
# (ADR-115: обработка вложений). pnpm в этой стадии НЕ ставится — `browser`
# не умеет собирать монорепо, pnpm появляется в `full`.
COPY docker/install-lib.sh docker/install-tier-1.sh docker/install-tier-3.sh \
     docker/install-media.sh docker/install-diag.sh /tmp/synth-install/
RUN set -eux; \
    sh /tmp/synth-install/install-tier-1.sh; \
    sh /tmp/synth-install/install-tier-3.sh; \
    sh /tmp/synth-install/install-media.sh; \
    sh /tmp/synth-install/install-diag.sh; \
    rm -rf /tmp/synth-install

# Git в контейнере работает с workspace'ами монтируемыми в образ (том
# `synth-workspace`) — помечаем их безопасными и задаём пользователя коммитов
# системно (иначе `git commit` в контейнере падал бы с «Please tell me who you
# are»).
RUN set -eux; \
    git config --system --add safe.directory '/var/synth/data/workspaces/*'; \
    git config --system user.name "Synth Agent"; \
    git config --system user.email "agent@synth.local"

# MCP-серверы по умолчанию — только во flavor'ах с браузером (`browser`/`full`,
# стадия `full` наследует ENV). В `core`/`dev`/`devops` переменная не задаётся:
# браузера там нет, и дефолт молча поднимал бы заведомо падающий сервер.
#
# Playwright MCP: `playwright-mcp` по умолчанию ищет **Google Chrome**
# (`/opt/google/chrome/chrome`), которого в образе нет (браузеры Playwright
# лежат в `PLAYWRIGHT_BROWSERS_PATH`), поэтому нужен `--executable-path` на
# стабильный симлинк tier 3. `--headless` — в контейнере нет дисплея;
# `--no-sandbox` — контейнер по умолчанию работает под root (uid 0), без флага
# Chromium не стартует (при запуске под uid 1000 флаг безвреден).
# Отключить дефолт: `SYNTH_EXECUTOR_MCP_SERVERS=''` (пустая строка = серверов нет).
ENV SYNTH_EXECUTOR_MCP_SERVERS='[{"name":"playwright-mcp","command":"playwright-mcp","args":["--headless","--no-sandbox","--executable-path","/opt/synth/browser/chrome"]}]'

# Рантайм исполнителя (см. стадию `core`).
COPY --from=build /out/app /app
COPY --from=build /out/core /opt/synth-core

WORKDIR /app

# Проверка в образе — fail-closed: без рабочего `InlineExecutionPort`
# исполнитель не сможет исполнять команды, и это должно быть видно на
# этапе сборки, а не в рантайме.
RUN set -eux; \
    mkdir -p /app/node_modules/@itphx; \
    ln -sfn /opt/synth-core /app/node_modules/@itphx/synth-core; \
    node -e "import('@itphx/synth-core').then((m) => { if (!m.InlineExecutionPort) { throw new Error('core без InlineExecutionPort'); } console.log('core runtime OK'); }).catch((e) => { console.error(e); process.exit(1); })"

EXPOSE 5100
# PID 1 (аудит 0.13.4 §5.2): `synth-init` — sh-скрипт (reaping осиротевших
# детей; Node/libuv этого не умеет), он запускает `dist/init.js` — Node-обёртку
# (проброс сигналов всей process group и кода выхода). Шапка файла.
COPY --from=build /repo/docker/init.sh /usr/local/bin/synth-init
CMD ["/bin/sh", "/usr/local/bin/synth-init", "node", "dist/init.js"]

# ------------------------------------------------------------------------------
# flavor `full` — browser + tier 2 + tier 4 + tier 5 + БД + docker CLI + buildah
# ------------------------------------------------------------------------------
FROM browser AS full

LABEL org.opencontainers.image.source="https://github.com/itphx/synth"
LABEL org.opencontainers.image.licenses="MIT"
LABEL org.opencontainers.image.title="Synth Executor (full)"
LABEL org.opencontainers.image.description="Synth executor: runtime исполнителя + toolchain (hard deps, tier 0-4, tier 5 repo lint, Playwright/Chromium, MCP servers, DB clients, buildah, diag tools, docker CLI, ffmpeg)."

# pnpm в образе: `full` умеет собирать монорепо внутри контейнера
# (`pnpm install --frozen-lockfile && pnpm build && pnpm typecheck &&
# pnpm lint`) и проверять чарт/скрипты/Dockerfile'ы репозитория (tier 5).
#
# Окружение corepack/pnpm — в HOME пользователя uid 1000 (процесс исполнителя
# идёт под runAsUser: 1000, HOME=/root недоступен для записи).
ENV COREPACK_HOME=/home/synth/.cache/node/corepack
ENV PNPM_HOME=/home/synth/.local/share/pnpm
ENV PATH=$PNPM_HOME:$PATH

# Версия pnpm зафиксирована и совпадает с `packageManager` в package.json
# репозитория (pnpm@12.14.0).
#
# `pnpm --version` здесь — не проверка, а MATERIALIZATION нативного бинаря:
# corepack кладёт в образ пакет-обёртку pnpm, а нативный бинарь
# (`@pnpm/exe.<platform>-<arch>`) обёртка скачивает при ПЕРВОМ запуске. Без
# этого шага первый вызов `pnpm` в контейнере требовал бы сети (и печатал
# «Downloading the pnpm … binary» перед версией).
RUN set -eux; \
    corepack enable && corepack prepare pnpm@12.14.0 --activate; \
    pnpm --version; \
    mkdir -p /home/synth/.cache/node/corepack /home/synth/.local/share/pnpm; \
    chown -R 1000:1000 /home/synth/.cache/node/corepack \
             /home/synth/.local/share/pnpm

# Git в контейнере работает с workspace'ами монтируемыми в образ (том
# `synth-workspace`) — помечаем их безопасными и задаём пользователя коммитов
# системно.
RUN set -eux; \
    git config --system --add safe.directory '/var/synth/data/workspaces/*'; \
    git config --system user.name "Synth Agent"; \
    git config --system user.email "agent@synth.local"

COPY docker/install-lib.sh docker/install-tier-2.sh docker/install-tier-5.sh \
     docker/install-tier-4.sh \
     docker/install-db-clients.sh docker/install-docker-cli.sh \
     docker/install-buildah.sh /tmp/synth-install/
RUN set -eux; \
    sh /tmp/synth-install/install-tier-2.sh; \
    sh /tmp/synth-install/install-tier-5.sh; \
    sh /tmp/synth-install/install-db-clients.sh; \
    sh /tmp/synth-install/install-docker-cli.sh; \
    sh /tmp/synth-install/install-buildah.sh
RUN set -eux; \
    sh /tmp/synth-install/install-tier-4.sh; \
    rm -rf /tmp/synth-install
