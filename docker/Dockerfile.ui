# Образ synth-ui собирается из ИСХОДНИКОВ монорепо (packages/ui) — vite build,
# чтобы Image содержал актуальный SPA.
FROM node:22-alpine AS build

RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /repo

# Копируем весь монорепо (для workspace-зависимостей и сборки shared → ui).
COPY . .

# Установка зависимостей и сборка в порядке: shared → ui (vite build).
RUN pnpm install --filter @itphx/synth-ui --filter @itphx/synth-shared \
    && pnpm --filter @itphx/synth-shared build \
    && pnpm --filter @itphx/synth-ui build

FROM nginx:alpine

# Собранный SPA (vite) + конфиг nginx с прокси на backend.
COPY --from=build /repo/packages/ui/dist /usr/share/nginx/html
# Гарантируем читаемость статики для nginx-воркера независимо от прав в контексте сборки
# (аналог защиты в Dockerfile.backend: chmod -R a+rX /app).
RUN chmod -R a+rX /usr/share/nginx/html
COPY docker/nginx-ui.conf /etc/nginx/conf.d/default.conf

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
