# Образ synth-ui собирается из ИСХОДНИКОВ монорепо (packages/ui) — vite build,
# чтобы Image содержал актуальный SPA.
#
# multi-arch (amd64/arm64): build-стадия — на `$BUILDPLATFORM`, runtime — на
# целевой. В runtime-стадии нет RUN (chmod перенесён в build), поэтому arm64
# собирается на amd64-раннере без QEMU/binfmt.
ARG BUILDPLATFORM

FROM --platform=${BUILDPLATFORM:-linux/amd64} node:22-alpine AS build

RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /repo

# Копируем весь монорепо (для workspace-зависимостей и сборки shared → ui).
COPY . .

# Установка зависимостей и сборка в порядке: shared → ui (vite build).
# chmod — здесь, на платформе билдера (в целевой стадии RUN нет: arm64 без QEMU).
RUN pnpm install --filter @itphx/synth-ui --filter @itphx/synth-shared \
    && pnpm --filter @itphx/synth-shared build \
    && pnpm --filter @itphx/synth-ui build \
    && chmod -R a+rX /repo/packages/ui/dist

FROM nginx:alpine

# OCI-метки: org.opencontainers.image.source связывает пакет в GHCR с
# репозиторием-источником (иначе GitHub Packages не показывает связь и
# унаследованные права доступа). Для GitVerse-сборки (kaniko) метки инертны.
LABEL org.opencontainers.image.source="https://github.com/itphx/synth"
LABEL org.opencontainers.image.licenses="MIT"
LABEL org.opencontainers.image.title="Synth UI"
LABEL org.opencontainers.image.description="Synth web UI: React 19 SPA served by nginx."

# Адрес backend'а — из окружения (ADR-077). Дефолт сохраняет прежнее поведение
# (Service `synth-backend` в том же namespace). В чарте значение — Service
# backend'а ТЕКУЩЕГО релиза: без этого второй инстанс Synth в одном namespace
# молча проксировал бы на backend основного инстанса (и OIDC-редирект уходил
# на чужой хост).
ENV SYNTH_BACKEND_URL=http://synth-backend:5000

# Фильтр envsubst официального образа nginx — regex по именам env-переменных:
# подставляется ТОЛЬКО SYNTH_BACKEND_URL, поэтому переменные самого nginx
# ($host, $remote_addr, $proxy_add_x_forwarded_for, $scheme) остаются нетронутыми.
ENV NGINX_ENVSUBST_FILTER=SYNTH_BACKEND_URL

# Собранный SPA (vite) + ШАБЛОН nginx-конфига: entrypoint образа подставляет env
# в /etc/nginx/templates/*.template и кладёт результат в /etc/nginx/conf.d/.
# Статическую копию конфига в образ НЕ кладём — иначе в /etc/nginx/conf.d/ были
# бы две копии server-блока (статичная и подставленная), а nginx взял бы обе.
COPY --from=build /repo/packages/ui/dist /usr/share/nginx/html
# Права (a+rX) выставлены в build-стадии (аналог защиты в Dockerfile.backend);
# в целевой стадии RUN нет — образ собирается под arm64 без эмуляции.
COPY docker/nginx-ui.conf.template /etc/nginx/templates/default.conf.template

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
