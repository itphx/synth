# Образ synth-ui: собранный @itphx/synth-ui (React 19 SPA) под nginx.
# Статика + reverse-proxy на synth-backend для /api, /ws, /auth, /admin, /health.
FROM node:22-alpine AS build

ARG SYNTH_UI_VERSION=latest

RUN corepack enable && corepack prepare pnpm@latest --activate

# Ставим пакет глобально, копируем собранный dist (из npm-публикации).
RUN GLOBAL_ROOT=$(npm root -g) \
  && npm install -g @itphx/synth-ui@${SYNTH_UI_VERSION} \
  && mkdir -p /app/dist \
  && cp -r "$GLOBAL_ROOT/@itphx/synth-ui/dist/." /app/dist/

FROM nginx:alpine

COPY --from=build /app/dist /usr/share/nginx/html
COPY docker/nginx-ui.conf /etc/nginx/conf.d/default.conf

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
