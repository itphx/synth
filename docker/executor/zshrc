# Продуктовый zshrc образа исполнителя Synth (zsh + Oh My Zsh, тема `synth`).
# Лежит в образе как `/etc/synth/zshrc`; в `$HOME` пользователя — симлинк
# `~/.zshrc` (заводит `docker/executor-init.sh` при старте контейнера).
# tmux запускает человек: автостарта tmux нет (у веб-терминала может быть
# несколько клиентов, а `tmux attach -d` отцепляет других).

export PATH=$HOME/bin:$HOME/.local/bin:/usr/local/bin:$PATH

export ZSH=/opt/oh-my-zsh
ZSH_THEME="synth"
# short (по умолчанию) — %c; full — %~
: "${ZSH_THEME_SYNTH_PATH:=short}"

# Обновления OMZ в рантайме выключены: образ неизменяем, сети может не быть.
zstyle ':omz:update' mode disabled
DISABLE_AUTO_UPDATE=true
DISABLE_AUTO_TITLE=true
export ZSH_CACHE_DIR="${ZSH_CACHE_DIR:-$HOME/.cache/oh-my-zsh}"

# Плагины — по фактически установленным бинарям (core/dev без docker/terraform,
# devops/full — с ними). git-prompt обязателен теме (git-статус).
plugins=(git git-prompt common-aliases)
(( $+commands[tmux] )) && plugins+=(tmux)
(( $+commands[docker] )) && plugins+=(docker docker-compose)
(( $+commands[kubectl] )) && plugins+=(kubectl)
(( $+commands[kubectx] )) && plugins+=(kubectx)
(( $+commands[terraform] )) && plugins+=(terraform)
(( $+commands[ansible] )) && plugins+=(ansible)

source $ZSH/oh-my-zsh.sh

export EDITOR=vim
export VISUAL="$EDITOR"

unsetopt share_history
