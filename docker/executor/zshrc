# Продуктовый zshrc образа исполнителя Synth (zsh + Oh My Zsh, тема `eof`).
#
# Где лежит: `/etc/synth/zshrc` — часть образа (`docker/Dockerfile.executor`,
# копируется из `docker/executor/zshrc`, стадии `core` и `full` — только они
# дают терминалы). В `$HOME` пользователя он попадает симлинком
# (`~/.zshrc` → `/etc/synth/zshrc`); симлинк заводит `docker/executor-init.sh`
# при старте контейнера — потому что при `readOnlyRootFilesystem` `$HOME`
# (`/home/synth`) — это `emptyDir`, и симлинк, созданный на этапе сборки
# образа, примонтированный том скрывает. Если `~/.zshrc` уже есть
# (пользователь заменил симлинк своим файлом) — ничего не трогаем:
# переопределение пользователя важнее.
#
# Источник конфигурации и темы — `git.itphx.ru/eka/.dots` (`zshrc`,
# `zsh/custom/themes/eof.zsh-theme`). Тема вендорится в репозиторий
# (`docker/executor/themes/eof.zsh-theme`), чтобы сборка не зависела от
# доступа к личному Gitea. Автостарт tmux из `.dots` НЕ переносится: у
# веб-терминала может быть несколько клиентов, а `tmux attach -d` отцепляет
# других.
#
# Назначение — рабочее место человека в терминале исполнителя (ADR
# терминалов). Никаких личных путей и никакого автостарта tmux.

export PATH=$HOME/bin:$HOME/.local/bin:/usr/local/bin:$PATH

# Oh My Zsh установлен в образе (`/opt/oh-my-zsh`, `docker/install-tier-6.sh`).
export ZSH=/opt/oh-my-zsh
ZSH_THEME="eof"

# eof: компактный промпт внутри tmux, обычный — вне его.
if [[ -n "$TMUX" ]]; then
  ZSH_THEME_EOF_MODE="tiny"
else
  ZSH_THEME_EOF_MODE="small"
fi

# Обновления OMZ в рантайме выключены: образ неизменяем, сети может не быть.
zstyle ':omz:update' mode disabled
DISABLE_AUTO_UPDATE=true

export ZSH_CACHE_DIR="${ZSH_CACHE_DIR:-$HOME/.cache/oh-my-zsh}"

# Плагины из .dots; git-prompt нужен теме eof. Отсутствующие бинари плагины
# переживают молча.
plugins=(git themes common-aliases git-prompt terraform tmux ansible docker docker-compose kubectl kubectx)

source $ZSH/oh-my-zsh.sh

export EDITOR=vim
export VISUAL="$EDITOR"

# Несколько вкладок терминала: история не шарится между сессиями.
unsetopt share_history

# tmux НЕ запускается автоматически: у веб-терминала может быть несколько
# клиентов, а `tmux attach -d` отцепляет других. tmux запускает человек.
