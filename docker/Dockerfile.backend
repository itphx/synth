# Образ synth-backend собирается из ИСХОДНИКОВ монорепо (packages/backend),
# чтобы Image содержал актуальный код (OIDC/Keycloak, env-провайдеры).
#
# Стадии (PROP-082, «Multistage-сборка»):
#   build — сборка монорепо (платформа билдера, `$BUILDPLATFORM`);
#   core  — flavor `core`: all-in-one = control plane + toolchain
#           (hard deps + tier 0). Здесь ЕСТЬ `RUN` (установка пакетов);
#   dev   — flavor `dev`: core + tier 1 + tier 4 + БД-клиенты + buildah;
#   devops— flavor `devops`: dev + tier 2 + диаг + docker CLI;
#   browser — flavor `browser` (debian-ветка): hard deps + tier 0 + tier 1 +
#           tier 3 (Playwright + Chromium) + диаг;
#   full  — flavor `full` (debian-ветка): browser + tier 2 + tier 4 + БД +
#           docker CLI + buildah;
#   slim  — control plane без toolchain'а. ПОСЛЕДНЯЯ стадия: сборка без
#           `--target` даёт ровно этот образ (регрессия slim недопустима).
#
# Flavor'ы `core`/`dev`/`devops` — alpine-ветка. Flavor'ы `browser`/`full` —
# debian-ветка (`node:22-bookworm-slim`): Playwright/Chromwright не имеют
# сборок под musl, поэтому для них база — glibc.
#
# multi-arch (amd64/arm64) для slim: стадия сборки идёт на платформе билдера
# (`$BUILDPLATFORM`), runtime — на целевой. В runtime-стадии нет RUN (chmod
# перенесён в стадию сборки, COPY сохраняет права), поэтому arm64 собирается
# на amd64-раннере без QEMU/binfmt. `${BUILDPLATFORM:-linux/amd64}` — дефолт
# для kaniko/legacy `docker build`.
#
# Архитектурное ограничение для flavor'ов (решение A — PROP-082):
# установка пакетов требует `RUN` в ЦЕЛЕВОЙ архитектуре, поэтому стадия
# `core` собирается под целевую платформу, и arm64-сборка flavor'а требует
# QEMU/binfmt на раннере. Стадия `core` намеренно БЕЗ явного `--platform`:
#   * buildx — стадия без `--platform` собирается под $TARGETPLATFORM ✓;
#   * kaniko — kaniko автоматические ARG-платформы НЕ задаёт (проверено на
#     kaniko v1.24.0: BUILDPLATFORM и TARGETPLATFORM пустые), а kaniko —
#     amd64-билдер в CI, и он собирает под свой собственный arch.
# Явный `--platform=${TARGETPLATFORM}` поставил бы kaniko-сборку в fail-closed
# (пустое значение), а дефолт `linux/amd64` сломал бы нативную arm64-сборку.
# Для slim-стадии поведение не меняется: там по-прежнему нет ни одного `RUN`.
ARG BUILDPLATFORM

FROM --platform=${BUILDPLATFORM:-linux/amd64} node:22-alpine AS build

# corepack скачивает бинарь pnpm при ПЕРВОМ вызове `pnpm` — то есть уже в
# следующем слое, где сеть может отвалиться (сборка падает на таймауте
# загрузки). Поэтому materialize бинаря здесь, в кэшируемом слое: сбой сети
# тогда не роняет сборку целиком, а повторная попытка переиспользует слой.
RUN corepack enable && corepack prepare pnpm@latest --activate && pnpm --version

WORKDIR /repo

# Копируем весь монорепо целиком (для workspace-зависимостей и сборки shared→core→backend).
COPY . .

# Установка зависимостей workspace и сборка в порядке: shared → core →
# storage-postgres → backend.
#
# `@itphx/synth-storage-postgres` — опциональный БД-драйвер слоя хранения
# (ADR-096/ADR-097), обязательный для `storage.backend=postgres`. Его нужно и
# установить, и собрать: `pnpm deploy` переносит workspace-пакеты по их `files`
# (только `dist`), поэтому непособанный пакет уехал бы в образ без кода.
# `--prod`/`--legacy` (ниже) optional-зависимости не выкидывают; `--no-optional`
# использовать нельзя.
RUN pnpm install --filter @itphx/synth-backend --filter @itphx/synth-core --filter @itphx/synth-shared --filter @itphx/synth-storage-postgres \
    && pnpm --filter @itphx/synth-shared build \
    && pnpm --filter @itphx/synth-core build \
    && pnpm --filter @itphx/synth-storage-postgres build \
    && pnpm --filter @itphx/synth-backend build

# pnpm deploy создаёт самодостаточную папку с реальными node_modules (без symlinks),
# включая транзитивные runtime-зависимости (@itphx/synth-core, ws и т.д.) и
# optionalDependencies (@itphx/synth-storage-postgres + pg — ADR-096).
RUN mkdir -p /out && pnpm --filter @itphx/synth-backend deploy --prod --legacy /out/app

# Права чиним здесь, на платформе билдера: файлы pnpm deploy имеют mode 770
# (root) и под runAsUser 1000 недоступны; второй COPY ниже кладёт поверх /app/dist
# каталог backend dist из рабочего дерева, а COPY переносит режимы как есть — при
# umask 002/ACL это 660 (EACCES у uid 1000 на /app/dist/main.js). Поэтому чиним
# оба источника до COPY. В целевой стадии RUN нет (важно для кросс-сборки arm64
# без эмуляции).
RUN chmod -R a+rX /out/app /repo/packages/backend/dist

# ------------------------------------------------------------------------------
# flavor `core` — all-in-one: control plane + toolchain (PROP-082)
# ------------------------------------------------------------------------------
#
# Toolchain: hard deps (git, ripgrep, python3 + pip + venv, openssh-client,
# ca-certificates) + tier 0 (bash, curl, jq, yq, unzip/zip, xz, zstd, GNU
# coreutils/findutils/grep/sed/gawk, less, tree, openssl). Состав зафиксирован
# в PROP-082; списки пакетов — в docker/install-hard-deps.sh и
# docker/install-tier-0.sh (distro-aware: один список на тир, выбор apk/apt).
FROM node:22-alpine AS core

# OCI-метки: org.opencontainers.image.source связывает пакет в GHCR с
# репозиторием-источником (иначе GitHub Packages не показывает связь и
# унаследованные права доступа). Для GitVerse-сборки (kaniko) метки инертны.
LABEL org.opencontainers.image.source="https://github.com/itphx/synth"
LABEL org.opencontainers.image.licenses="MIT"
LABEL org.opencontainers.image.title="Synth Backend (core)"
LABEL org.opencontainers.image.description="Synth backend all-in-one: control plane (OIDC/RBAC, runner registry, LLM proxy) + toolchain (hard deps + tier 0)."

ENV NODE_ENV=production
ENV SYNTH_DATA_DIR=/var/synth/data
ENV SYNTH_PORT=5000

# Toolchain. Скрипты distro-aware и идемпотентны: apk/apt пропускают уже
# установленное, интерактива нет.
COPY docker/install-lib.sh docker/install-hard-deps.sh docker/install-tier-0.sh /tmp/synth-install/
RUN set -eux; \
    sh /tmp/synth-install/install-hard-deps.sh; \
    sh /tmp/synth-install/install-tier-0.sh; \
    rm -rf /tmp/synth-install

# Каталоги пользователя uid 1000 и его HOME. Причина: чарт запускает backend
# с runAsUser: 1000 (charts/synth/values.yaml), а HOME по умолчанию /root —
# не writable, из-за чего `pip install --user` и кэши python падают с EACCES.
#
# В базовом образе node:22-alpine uid/gid 1000 уже заняты пользователем
# `node` (busybox adduser не даёт создать второго владельца uid 1000), поэтому
# отдельная учётная запись не создаётся — важен сам uid: каталоги принадлежат
# 1000:1000, и процесс под runAsUser: 1000 пишет в них без правки.
RUN set -eux; \
    mkdir -p /home/synth/.cache/pip /home/synth/.local /var/synth/data; \
    chown -R 1000:1000 /home/synth /var/synth/data

# Python-окружение и кэши (PROP-082, «Python-окружение и кэши»): HOME,
# PYTHONUSERBASE и PIP_CACHE_DIR указывают в каталоги uid 1000 — при запуске
# от runAsUser: 1000 они writable, а кэш pip переживает перезапуск контейнера,
# если каталог смонтирован на volume (volume + fsGroup — шаг 7/12).
ENV HOME=/home/synth
ENV PYTHONUSERBASE=/home/synth/.local
ENV PIP_CACHE_DIR=/home/synth/.cache/pip

COPY --from=build /out/app /app

# Скомпилированный код backend поверх pnpm deploy.
COPY --from=build /repo/packages/backend/dist /app/dist

WORKDIR /app
# Права (a+rX) выставлены в стадии сборки, здесь только читаем из образа.
CMD ["node", "dist/main.js"]

# ------------------------------------------------------------------------------
# flavor `dev` — core + tier 1 + tier 4 + БД-клиенты + buildah (PROP-082)
# ------------------------------------------------------------------------------
#
# Состав (PROP-082, «Flavor-матрица»):
#   * core            — hard deps + tier 0 + control plane (наследуется);
#   * tier 1          — сборка: make/gcc/g++/musl-dev/python3-dev/pkgconf/
#                       patch/diffutils/git-lfs/rsync;
#   * tier 4          — MCP-серверы github/gitea/gitverse/gitlab (npm, пин
#                       версии + integrity);
#   * БД-клиенты      — sqlite3/psql/redis-cli/mysql-client;
#   * buildah         — сборка образов из сессии (в контейнере требует
#                       user namespaces / --isolation=chroot — см. шапку
#                       docker/install-buildah.sh).
#
# Стадия наследует `core`, поэтому HOME=/home/synth, PYTHONUSERBASE и
# PIP_CACHE_DIR (кэши на volume) приходят из неё без повторов.
FROM core AS dev

LABEL org.opencontainers.image.source="https://github.com/itphx/synth"
LABEL org.opencontainers.image.licenses="MIT"
LABEL org.opencontainers.image.title="Synth Backend (dev)"
LABEL org.opencontainers.image.description="Synth backend all-in-one: control plane + toolchain (hard deps, tier 0-1, tier 4 MCP servers, DB clients, buildah)."

# Скрипты distro-aware и идемпотентны: apk/apt пропускают уже
# установленное, интерактива нет. Каталог с удаляется в конце стадии.
COPY docker/install-lib.sh docker/install-tier-1.sh docker/install-db-clients.sh \
     docker/install-buildah.sh docker/install-tier-4.sh /tmp/synth-install/
RUN set -eux; \
    sh /tmp/synth-install/install-tier-1.sh; \
    sh /tmp/synth-install/install-db-clients.sh; \
    sh /tmp/synth-install/install-buildah.sh
# npm-слой (tier 4) отдельным RUN: смена состава MCP-серверов не должна
# инвалидировать слои с системными пакетами.
RUN set -eux; \
    sh /tmp/synth-install/install-tier-4.sh; \
    rm -rf /tmp/synth-install

# ------------------------------------------------------------------------------
# flavor `devops` — dev + tier 2 + диаг + docker CLI (PROP-082)
# ------------------------------------------------------------------------------
#
# devops ⊃ dev: наследует всю toolchain'у `dev` и добавляет инфраструктурный
# тир (kubectl/helm/kustomize/ansible/opentofu/yamllint/shellcheck/hadolint),
# диагностические утилиты (dig/nc/traceroute/lsof/ss) и docker CLI.
#
# docker — ТОЛЬКО CLI: демона в образе нет, `docker.sock` не пробрасывается
# ни в одном flavor'е (PROP-082, «Две топологии развёртывания»).
FROM dev AS devops

LABEL org.opencontainers.image.source="https://github.com/itphx/synth"
LABEL org.opencontainers.image.licenses="MIT"
LABEL org.opencontainers.image.title="Synth Backend (devops)"
LABEL org.opencontainers.image.description="Synth backend all-in-one: control plane + toolchain (hard deps, tier 0-2, tier 4 MCP servers, DB clients, buildah, diag tools, docker CLI)."

COPY docker/install-lib.sh docker/install-tier-2.sh docker/install-diag.sh \
     docker/install-docker-cli.sh /tmp/synth-install/
RUN set -eux; \
    sh /tmp/synth-install/install-tier-2.sh; \
    sh /tmp/synth-install/install-diag.sh; \
    sh /tmp/synth-install/install-docker-cli.sh; \
    rm -rf /tmp/synth-install

# ------------------------------------------------------------------------------
# debian-ветка: flavor'ы `browser`/`full` (PROP-082, шаг 5)
# ------------------------------------------------------------------------------
#
# База — `node:22-bookworm-slim` (glibc): Playwright/Chromium официально не
# поддерживают musl, поэтому для `browser`/`full` база обязана быть glibc.
#
#   browser — hard deps + tier 0 + tier 1 + tier 3 (playwright + Chromium +
#             @playwright/mcp + libxml2-utils) + диаг + control plane;
#   full    — browser + tier 2 (инфра) + tier 4 (MCP-серверы) + БД-клиенты +
#             docker CLI + buildah.
#
# Отличие от alpine-ветки: в debian `yq` из apt — python-реализация с
# несовместимым CLI, поэтому ставится Go-вариант из upstream (пин + sha256);
# docker CLI — статический бандл docker (в apt нет клиента без демона).
FROM node:22-bookworm-slim AS browser

# OCI-метки: org.opencontainers.image.source связывает пакет в GHCR с
# репозиторием-источником (иначе GitHub Packages не показывает связь и
# унаследованные права доступа). Для GitVerse-сборки (kaniko) метки инертны.
LABEL org.opencontainers.image.source="https://github.com/itphx/synth"
LABEL org.opencontainers.image.licenses="MIT"
LABEL org.opencontainers.image.title="Synth Backend (browser)"
LABEL org.opencontainers.image.description="Synth backend all-in-one: control plane + toolchain (hard deps, tier 0-1, tier 3 Playwright/Chromium, MCP playwright, diag)."

ENV NODE_ENV=production
ENV SYNTH_DATA_DIR=/var/synth/data
ENV SYNTH_PORT=5000

# Toolchain: hard deps (git, ripgrep, python3 + pip + venv, openssh-client,
# ca-certificates) + tier 0 (bash, curl, jq, yq, unzip/zip, xz, zstd, GNU
# coreutils/findutils/grep/sed/gawk, less, tree, openssl).
COPY docker/install-lib.sh docker/install-hard-deps.sh docker/install-tier-0.sh /tmp/synth-install/
RUN set -eux; \
    sh /tmp/synth-install/install-hard-deps.sh; \
    sh /tmp/synth-install/install-tier-0.sh; \
    rm -rf /tmp/synth-install

# Каталоги пользователя uid 1000 и его HOME — те же, что в alpine-ветке
# (чарт запускает backend с runAsUser: 1000, а HOME по умолчанию /root —
# не writable, из-за чего `pip install --user` и кэши python падают с EACCES).
#
# В `node:22-bookworm-slim` uid/gid 1000 уже заняты пользователем `node`
# (как и в alpine-образе), поэтому отдельная учётная запись не создаётся —
# важен сам uid: каталоги принадлежат 1000:1000.
RUN set -eux; \
    mkdir -p /home/synth/.cache/pip /home/synth/.local /var/synth/data; \
    chown -R 1000:1000 /home/synth /var/synth/data

# Python-окружение и кэши (PROP-082, «Python-окружение и кэши»).
ENV HOME=/home/synth
ENV PYTHONUSERBASE=/home/synth/.local
ENV PIP_CACHE_DIR=/home/synth/.cache/pip

# Каталог браузеров Playwright: общий для всех пользователей образа
# (в том числе uid 1000) и НЕ на HOME — иначе при runAsUser: 1000 каталог
# не читался бы. Chromium печётся в образ (см. docker/install-tier-3.sh).
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright

# tier 1 (сборка) + tier 3 (playwright + Chromium) + диагностика.
# tier 3 ставит npm-пакеты и печёт браузеры — отдельным слоем, чтобы смена
# состава MCP-серверов не инвалидировала слои системных пакетов.
COPY docker/install-lib.sh docker/install-tier-1.sh docker/install-tier-3.sh \
     docker/install-diag.sh /tmp/synth-install/
RUN set -eux; \
    sh /tmp/synth-install/install-tier-1.sh; \
    sh /tmp/synth-install/install-tier-3.sh; \
    sh /tmp/synth-install/install-diag.sh; \
    rm -rf /tmp/synth-install

# Control plane — в конце: смена кода не инвалидирует слои toolchain'а.
COPY --from=build /out/app /app

# Скомпилированный код backend поверх pnpm deploy.
COPY --from=build /repo/packages/backend/dist /app/dist

WORKDIR /app
CMD ["node", "dist/main.js"]

# ------------------------------------------------------------------------------
# flavor `full` — browser + tier 2 + tier 4 + БД + docker CLI + buildah
# ------------------------------------------------------------------------------
#
# full ⊃ browser: наследует всю toolchain'у `browser` (включая Playwright с
# Chromium) и добавляет инфраструктурный тир (kubectl/helm/kustomize/
# ansible/opentofu/yamllint/shellcheck/hadolint), MCP-серверы SCM-хостингов,
# клиенты БД, docker CLI и buildah.
FROM browser AS full

LABEL org.opencontainers.image.source="https://github.com/itphx/synth"
LABEL org.opencontainers.image.licenses="MIT"
LABEL org.opencontainers.image.title="Synth Backend (full)"
LABEL org.opencontainers.image.description="Synth backend all-in-one: control plane + toolchain (hard deps, tier 0-4, Playwright/Chromium, MCP servers, DB clients, buildah, diag tools, docker CLI)."

COPY docker/install-lib.sh docker/install-tier-2.sh docker/install-tier-4.sh \
     docker/install-db-clients.sh docker/install-docker-cli.sh \
     docker/install-buildah.sh /tmp/synth-install/
RUN set -eux; \
    sh /tmp/synth-install/install-tier-2.sh; \
    sh /tmp/synth-install/install-db-clients.sh; \
    sh /tmp/synth-install/install-docker-cli.sh; \
    sh /tmp/synth-install/install-buildah.sh
# npm-слой (tier 4) отдельным RUN: смена состава MCP-серверов не должна
# инвалидировать слои с системными пакетами.
RUN set -eux; \
    sh /tmp/synth-install/install-tier-4.sh; \
    rm -rf /tmp/synth-install

# ------------------------------------------------------------------------------
# slim — control plane без toolchain'а (последняя стадия = цель по умолчанию)
# ------------------------------------------------------------------------------
#
# Содержимое стадии — ровно то, что было до появления flavor'ов: ни одного
# `RUN`, только COPY/ENV/LABEL/CMD. Поэтому образ `synth-backend:<v>` не
# меняется ни байтом по составу и продолжает собираться под arm64 на
# amd64-раннере без QEMU/binfmt.
FROM node:22-alpine AS slim

# OCI-метки: org.opencontainers.image.source связывает пакет в GHCR с
# репозиторием-источником (иначе GitHub Packages не показывает связь и
# унаследованные права доступа). Для GitVerse-сборки (kaniko) метки инертны.
LABEL org.opencontainers.image.source="https://github.com/itphx/synth"
LABEL org.opencontainers.image.licenses="MIT"
LABEL org.opencontainers.image.title="Synth Backend"
LABEL org.opencontainers.image.description="Synth backend API hub: OIDC/RBAC, runner registry, LLM proxy."

ENV NODE_ENV=production
ENV SYNTH_DATA_DIR=/var/synth/data
ENV SYNTH_PORT=5000

COPY --from=build /out/app /app

# Скомпилированный код backend поверх pnpm deploy.
COPY --from=build /repo/packages/backend/dist /app/dist

WORKDIR /app
# Права (a+rX) выставлены в стадии сборки, здесь только читаем из образа.
CMD ["node", "dist/main.js"]
