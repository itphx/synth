node_modules/
# Артефакты сборки — и корневой `dist/`, и вложенные `packages/*/dist/`.
# Паттерн `dist/` в .dockerignore совпадает ТОЛЬКО с корневым каталогом, поэтому
# вложенные dist попадали в контекст сборки и маскировали отсутствие собранного
# пакета в образе (например @itphx/synth-executor: локально собранный
# packages/executor/dist переезжал в образ, а на чистом checkout/CI образ был бы
# без пакета). Образы собирают пакеты сами (build-стадия: `pnpm --filter … build`),
# а `COPY --from=build` берёт артефакты уже оттуда — исключение безопасно.
# Промпты/определения/манифесты (`packages/*/prompts/`, `packages/*/definitions/`,
# `packages/*/package.json`) в контексте остаются — они нужны сборке.
dist/
**/dist/
.git/
.gitverse/
tmp/
*.log
.env
.env.*
.DS_Store

# Deploy-плагины: бандлы из `docker/plugins/` обязаны попасть в контекст сборки —
# `docker/Dockerfile.backend` (стадия build) копирует каталог в `/opt/synth/plugins`.
# Правило `**/dist/` выше иначе вырезало бы собранный бандл плагина (`docker/plugins/<name>/dist/index.js`).
!docker/plugins
!docker/plugins/**
